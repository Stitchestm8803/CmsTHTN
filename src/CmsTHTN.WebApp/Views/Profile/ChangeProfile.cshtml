﻿@{
    ViewData["Title"] = "Edit profile";
    ViewData["Description"] = "Edit profile";

}
@model ChangeProfileViewModel
<!-- Page Header-->
<header class="masthead" style="background-image: url('/assets/img/home-background.jpg')">
    <div class="container position-relative px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
                <div class="site-heading">
                    <h1>Sửa hồ sơ</h1>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- Main Content-->
<div class="container px-4 px-lg-5 justify-content-center">
    <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-6">
            <form asp-action="ChangeProfile" asp-controller="Profile" method="post">
                <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
                @if (TempData[SystemConsts.FormSuccessMsg] != null)
                {
                    <div class="alert alert-success">@TempData[SystemConsts.FormSuccessMsg]</div>
                }
                <div class="col-md-8">
                    <label for="firstName" class="form-label">Họ</label>
                    <input type="text" class="form-control" asp-for="FirstName" id="firstName" required readonly style="color: #6c757d;">
                    <span asp-validation-for="FirstName" class="invalid-feedback"></span>
                </div>
                <div class="col-md-8">
                    <label for="lastName" class="form-label">Tên</label>
                    <input type="text" class="form-control" asp-for="LastName" id="lastName" required readonly style="color: #6c757d;">
                    <span asp-validation-for="LastName" class="invalid-feedback"></span>

                </div>
                <div class="col-md-6">
                    <label for="dateOfBirth" class="form-label">Ngày sinh</label>
                    <input type="date" class="form-control" asp-for="Dob" id="dateOfBirth" required>
                    <span asp-validation-for="Dob" class="invalid-feedback"></span>
                </div>

                <div class="col-md-8">
                    <label for="phoneNumber" class="form-label">Số điện thoại</label>
                    <input type="text" class="form-control" asp-for="PhoneNumber" id="phoneNumber" required>
                    <span asp-validation-for="PhoneNumber" class="invalid-feedback"></span>
                </div>

                <div class="col-12 mt-3">
                    <button class="btn btn-primary" type="submit">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>