﻿@{
    ViewData["Title"] = "Edit post";
    ViewData["Description"] = "Edit post";

}
@section Scripts {
    <script src="https://cdn.tiny.cloud/1/e1x5t2iiu7zadoz0g4awq2jp988me4tdpxzt6ktba28ggrdk/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: 'textarea#txtContent',
            branding: false, // Ẩn logo TinyMCE
            plugins: [
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'image', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount'
            ],
            toolbar: 'undo redo | bold italic underline | link image media table | emoticons charmap | removeformat'
        });
    </script>
}
@model EditPostViewModel
<!-- Page Header-->
<header class="masthead" style="position: relative; background-image: url('https://localhost:7240/@Model.ThumbnailImage'); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                filter: blur(5px); z-index: 0;"></div>
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                background-color: rgba(0, 0, 0, 0.7); z-index: 1;"></div>
    <div class="container position-relative px-4 px-lg-5" style="position: relative; z-index: 2; color: white;">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
                <div class="post-heading" style="text-align: center;">
                    <h1>@Model.Title</h1>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- Main Content-->
<div class="container px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">
            <form asp-action="EditPost" asp-controller="Profile" method="post" enctype="multipart/form-data">
                <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
                <input type="hidden" name="id" value="@Model.Id"/>
                @if (TempData[SystemConsts.FormSuccessMsg] != null)
                {
                    <div class="alert alert-success">@TempData[SystemConsts.FormSuccessMsg]</div>
                }
                <div class="col-md-12">
                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                    <select asp-for="CategoryId" class="form-control" asp-items="Model.Categories">
                        <option>Chọn danh mục</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="invalid-feedback"></span>

                </div>
                <div class="col-md-12 mt-3">
                    <label for="thumbnail" class="form-label">Thumbnail</label>
                    <input type="file" class="form-control" name="thumbnail" id="thumbnail">
                    <input type="hidden" asp-for="ThumbnailImage" />
                    @if (!string.IsNullOrEmpty(Model.ThumbnailImage))
                    {
                        <img src="https://localhost:7240/@Url.Content(Model.ThumbnailImage)" alt="Thumbnail bài viết" style="width: 200px; height: auto" />
                    }
                </div>
                <div class="col-md-12 mt-3">
                    <label for="Description" class="form-label">Mô tả</label>
                    <textarea class="form-control" asp-for="Description" id="Description" rows="5"></textarea>
                    <span asp-validation-for="Description" class="invalid-feedback"></span>
                </div>
                
                
                <div class="col-md-12 mt-3">
                    <label for="SeoDescription" class="form-label">Mô tả SEO</label>
                    <textarea class="form-control" asp-for="SeoDescription" id="SeoDescription" rows="2"></textarea>
                </div>
                <div class="col-md-12 mt-3">
                    <label for="Content" class="form-label">Nội dung</label>
                    <textarea class="form-control" asp-for="Content" id="txtContent"></textarea>
                </div>
                <div class="col-12 mt-3">
                    <button class="btn btn-primary me-3" type="submit">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>