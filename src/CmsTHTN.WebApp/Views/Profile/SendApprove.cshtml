﻿@{
    ViewData["Title"] = "Post-send Approve";
    ViewData["Description"] = "Post-send Approve";
}
<!-- Page Header-->
<header class="masthead" style="background-image: url('/assets/img/home-bg.jpg')">
    <div class="container position-relative px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
                <div class="site-heading">
                    <h1>Xác nhận gửi duyệt</h1>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- Main Content-->
<div class="container px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">
            <form asp-action="SendApprove" asp-controller="Profile" method="post" enctype="multipart/form-data">
                <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
                @if (TempData[SystemConsts.FormSuccessMsg] != null)
                {
                    <div class="alert alert-success">@TempData[SystemConsts.FormSuccessMsg]</div>
                }
                <form method="post" action="/approve=true">
                    <button class="btn btn-primary me-3" type="submit">Xác nhận</button>
                </form>
                <form method="post" action="/approve=false">
                    <button class="btn btn-primary me-3" type="submit">Hủy</button>
                </form>

            </form>
        </div>
    </div>
</div>