@model PostDetailViewModel
@{
    ViewData["Title"] = Model.Post.Name;
    ViewData["Description"] = Model.Post.SeoDescription;
}
<!-- Page Header-->
<header class="masthead" style="position: relative; background-image: url('https://localhost:7240/@Model.Post.Thumbnail'); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                filter: blur(5px); z-index: 0;"></div>
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                background-color: rgba(0, 0, 0, 0.7); z-index: 1;"></div>
    <div class="container position-relative px-4 px-lg-5" style="position: relative; z-index: 2; color: white;">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
                <div class="post-heading" style="text-align: center;">
                    <h1>@Model.Post.Name</h1>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- Post Content-->
<article class="mb-4">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
                @Html.Raw(Model.Post.Content)
                <span class="meta" style="float: right;">
                    <a href="@string.Format(UrlConsts.Author,Model.Post.AuthorUserName)">@Model.Post.AuthorName</a>
                </span>
                <p>
                    @foreach(var tag in Model.Tags)
                    {
                        <a title="@tag.Name" href="@string.Format(UrlConsts.PostsByTagSlug, tag.Slug)">@tag.Name</a>
                    }
                </p>
            </div>
        </div>
    </div>
</article>