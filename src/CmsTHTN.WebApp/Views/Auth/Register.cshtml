﻿@{
    ViewData["Title"] = "Register";
    ViewData["Description"] = "Register new member";
}
@model RegsiterViewModel
<!-- Page Header-->
<header class="masthead" style="background-image: url('/assets/img/home-background.jpg')">
    <div class="container position-relative px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
                <div class="site-heading">
                    <h1>Đăng ký thành viên</h1>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- Main Content-->
<div class="container px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-6">
            <form asp-action="Register" asp-controller="Auth" method="post" class="row g-12">
                <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
                <div class="col-md-6">
                    <label for="firstName" class="form-label">Họ</label>
                    <input type="text" class="form-control" asp-for="FirstName" id="firstName" required>
                    <span asp-validation-for="FirstName" class="invalid-feedback"></span>
                </div>
                <div class="col-md-6">
                    <label for="lastName" class="form-label">Tên</label>
                    <input type="text" class="form-control" asp-for="LastName" id="lastName" required>
                    <span asp-validation-for="LastName" class="invalid-feedback"></span>

                </div>
                <div class="col-md-12 mt-3">
                    <label for="email" asp-for="Email" class="form-label">Email</label>
                    <div class="input-group has-validation">
                        <span class="input-group-text" id="inputGroupPrepend3">@@</span>
                        <input type="text" class="form-control" id="email" asp-for="Email" required>
                        <span asp-validation-for="Email" class="invalid-feedback"></span>
                    </div>
                </div>
                <div class="col-md-12 mt-3">
                    <label for="password" class="form-label">Mật khẩu</label>
                    <input type="password" asp-for="Password" class="form-control" id="password" required>
                    <span asp-validation-for="Password" class="invalid-feedback"></span>

                </div>
                <div class="col-md-12 mt-3">
                    <label for="confirmPassword" class="form-label">Xác nhận mật khẩu</label>
                    <input type="password" asp-for="ConfirmPassword" class="form-control" id="confirmPassword" required>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="col-12 mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="agree" required>
                        <label class="form-check-label" for="agree">
                            Đồng ý <a href="">điều khoản và điều kiện</a>
                        </label>
                    </div>
                </div>
                <div class="col-12 mt-3">
                    <button class="btn btn-primary" type="submit">Đăng ký</button>
                </div>
                
            </form>
        </div>
    </div>
</div>